+import {test} from 'node:test'
+import assert from 'node:assert/strict'
+import {buildResearchPrompt,finalResearch,parseResearch} from '../src/tracking-worker.ts'
+test('only a completed research turn is committed',()=>{
+ const message={event:{type:'assistant/message',data:{message:{content:[{type:'text',text:'{"summary":"ok"}'}]}}}}
+ assert.equal(finalResearch({records:[message]}),undefined)
+ assert.equal(finalResearch({records:[message,{event:{type:'turn/end',data:{reason:{kind:'completed'}}}}]}),'{"summary":"ok"}')
+ assert.throws(()=>finalResearch({records:[message,{event:{type:'turn/end',data:{reason:{kind:'error'}}}}]}))
+ assert.deepEqual(parseResearch('```json\n{"summary":"ok"}\n```'),{summary:'ok'})
+ assert.throws(()=>parseResearch('[]'))
+})
+test('long-term research prompt uses the five skills and role-based action schema',()=>{
+ const prompt=buildResearchPrompt({task:{symbol:'ZECUSDT'},metrics:{results:{'market-trend':{}}}})
+ for(const skill of ['market-trend','market-volume','market-s-r','market-breakout','market-exhaustion'])assert.ok(prompt.includes(skill))
+ for(const layer of ['宏观金融环境','跨资产传导','资本开支','估值和叙事','反身性与泡沫','边际变化'])assert.ok(prompt.includes(layer))
+ assert.match(prompt,/buy、hold、sell、insufficient/)
+ assert.match(prompt,/量价战术判断/)
+ assert.match(prompt,/无需等待基本面全部接入/)
+ assert.match(prompt,/probabilities/)
+ assert.match(prompt,/不要在回答中自行改写百分比/)
+ assert.match(prompt,/ZECUSDT/)
+})
