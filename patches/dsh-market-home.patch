diff --git a/apps/desktop/src/market-home.ts b/apps/desktop/src/market-home.ts
new file mode 100644
index 0000000000..d300604d29
--- /dev/null
+++ b/apps/desktop/src/market-home.ts
@@ -0,0 +1,106 @@
+/** Development market homepage: fixed asset and loopback API allowlists. */
+
+const PAGE = 'dsh-app://market/index.html'
+const ASSETS = new Set(['index.html', 'style.css', 'renderer.js', 'chart.js', 'chat-view.js', 'market-tracking-view.js', 'tracking.html', 'tracking.js'])
+const CATEGORIES = new Set(['SPOT', 'USDT-FUTURES', 'USDC-FUTURES', 'COIN-FUTURES'])
+
+/** Resolve an owned asset; arbitrary files and other origins have no mapping.
+ * @param address Custom-protocol request URL.
+ * @returns An allowlisted basename, or undefined.
+ */
+export function marketAsset(address: string): string | undefined {
+  const url = new URL(address)
+  if (url.protocol !== 'dsh-app:' || url.hostname !== 'market' || url.port || url.username || url.password) return undefined
+  const name = url.pathname.slice(1)
+  return ASSETS.has(name) ? name : undefined
+}
+
+/** Reject IPC outside the main market frame.
+ * @param event Sender identity supplied by Electron.
+ * @param owner Main window's webContents.
+ */
+export function assertMarketSender(
+  event: { sender: unknown; senderFrame: { url: string } | null },
+  owner: { mainFrame: unknown } | undefined,
+  page = PAGE,
+): void {
+  if (!owner || event.sender !== owner || event.senderFrame !== owner.mainFrame || event.senderFrame?.url !== page) {
+    throw new Error('market desktop: unauthorized frame')
+  }
+}
+
+interface RequestSpec {
+  method: 'GET' | 'POST' | 'PUT'
+  path: string
+  body?: Record<string,unknown>
+}
+
+function object(value: unknown): Record<string, unknown> {
+  if (typeof value !== 'object' || value === null || Array.isArray(value)) throw new Error('market desktop: invalid payload')
+  return value as Record<string, unknown>
+}
+
+function instrument(value: unknown, allowEmpty = false): { category: string; symbol: string } {
+  const data = object(value)
+  const category = data.category ?? 'SPOT'
+  const symbol = data.symbol ?? ''
+  if (typeof category !== 'string' || !CATEGORIES.has(category)
+    || typeof symbol !== 'string' || !(allowEmpty ? /^[A-Z0-9]{0,40}$/u : /^[A-Z0-9]{1,40}$/u).test(symbol)) {
+    throw new Error('market desktop: invalid instrument')
+  }
+  return { category, symbol }
+}
+
+/** Map validated renderer operations to a fixed loopback API route.
+ * @param action Allowlisted operation name.
+ * @param payload Untrusted structured renderer data.
+ * @returns Fixed method, route and optional reduced watchlist body.
+ */
+export function marketRequest(action: unknown, payload?: unknown): RequestSpec {
+  if(action==='wechat')return {method:'GET',path:'/api/wechat'}
+  if(action==='wechat-login')return {method:'POST',path:'/api/wechat/login'}
+  if(action==='wechat-login-status'){
+    const data=object(payload??{})
+    if(data.verify_code!==undefined&&(typeof data.verify_code!=='string'||!/^\d{1,10}$/.test(data.verify_code)))throw Error('invalid verify code')
+    return {method:'POST',path:'/api/wechat/login/status',body:data.verify_code===undefined?{}:{verify_code:data.verify_code}}
+  }
+  if(action==='wechat-configure'){
+    const data=object(payload)
+    if(Object.keys(data).some(key=>!['enabled','cadence_hours'].includes(key))||
+       (data.enabled!==undefined&&typeof data.enabled!=='boolean')||
+       (data.cadence_hours!==undefined&&(!Number.isInteger(data.cadence_hours)||Number(data.cadence_hours)<1||Number(data.cadence_hours)>24)))throw Error('invalid wechat configuration')
+    return {method:'PUT',path:'/api/wechat/configure',body:data}
+  }
+  if(action==='tracking')return {method:'GET',path:'/api/tracking'}
+  if(action==='tracking-history'){
+    const data=object(payload),selected=instrument(data)
+    if(data.before!==undefined&&(typeof data.before!=='string'||!/^[0-9]+(?:\.[0-9]+)?\|[A-Za-z0-9-]{1,64}$/.test(data.before)))throw Error('invalid history cursor')
+    const query=new URLSearchParams({task:selected.category+':'+selected.symbol,limit:'10'})
+    if(data.before!==undefined)query.set('before',data.before)
+    return {method:'GET',path:'/api/tracking/history?'+query}
+  }
+  if(action==='tracking-configure'){
+    const data=object(payload),selected=instrument(data)
+    if(typeof data.enabled!=='boolean')throw Error('invalid tracking switch')
+    if(data.interval!==undefined&&(typeof data.interval!=='string'||!/^(1m|5m|15m|1H|4H|1D)$/.test(data.interval)))throw Error('invalid interval')
+    if(data.note!==undefined&&(typeof data.note!=='string'||data.note.length>2000))throw Error('invalid note')
+    return {method:'PUT',path:'/api/tracking/configure',body:{...selected,enabled:data.enabled,...(data.interval===undefined?{}:{interval:data.interval}),...(data.note===undefined?{}:{note:data.note})}}
+  }
+  if (action === 'status') return { method: 'GET', path: '/api/status' }
+  if (action === 'poll') return { method: 'POST', path: '/api/poll' }
+  if (action === 'markets') return { method: 'GET', path: `/api/markets?${new URLSearchParams({category:instrument(payload ?? {}, true).category})}` }
+  if (action === 'instruments') return { method: 'GET', path: `/api/instruments?${new URLSearchParams(instrument(payload ?? {}, true))}` }
+  if (action === 'candles') {
+    const data = object(payload)
+    const selected = instrument(data)
+    const interval = data.interval ?? '1m'
+    if (typeof interval !== 'string' || !/^(1m|5m|15m|1H|4H|1D)$/u.test(interval)) throw new Error('market desktop: invalid candles')
+    return { method: 'GET', path: `/api/candles?${new URLSearchParams({ ...selected, interval })}` }
+  }
+  if (action === 'watchlist') {
+    const data = object(payload)
+    if (!Array.isArray(data.items) || data.items.length > 50) throw new Error('market desktop: invalid watchlist')
+    return { method: 'PUT', path: '/api/watchlist', body: { items: data.items.map(item => instrument(item)) } }
+  }
+  throw new Error('market desktop: unsupported operation')
+}
