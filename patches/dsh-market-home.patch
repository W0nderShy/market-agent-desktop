+/** Validate and compact the exact chart visible in the terminal. */
+export function chartContext(value: unknown) {
+ const x=value as {symbol?:unknown;category?:unknown;interval?:unknown;capturedAt?:unknown;rows?:unknown}
+ if(!x||typeof x.symbol!=='string'||!/^[A-Z0-9]{1,40}$/.test(x.symbol)||!['SPOT','USDT-FUTURES','USDC-FUTURES','COIN-FUTURES'].includes(String(x.category))||!['1m','5m','15m','1H','4H','1D'].includes(String(x.interval))||typeof x.capturedAt!=='number'||!Number.isFinite(x.capturedAt)||!Array.isArray(x.rows)||!x.rows.length||x.rows.length>300)throw new Error('当前图表尚未就绪')
+ let previous=0
+ const candles=x.rows.map((row:unknown)=>{
+  const r=row as Record<string,unknown>;const values=['time','open','high','low','close','volume'].map(k=>r?.[k]);
+  if(!values.every(v=>typeof v==='number'&&Number.isFinite(v)))throw new Error('K 线数据无效')
+  const [t,o,h,l,c,v]=values as [number,number,number,number,number,number]
+  if(t<=previous||Math.min(o,h,l,c)<=0||v<0||h<Math.max(o,l,c)||l>Math.min(o,h,c))throw new Error('K 线数据无效')
+  previous=t;return [t,o,h,l,c,v]
+ })
+ return {symbol:x.symbol,category:x.category,interval:x.interval,capturedAt:x.capturedAt,latestCandleMayChange:true,count:candles.length,columns:['timeUnixSeconds','open','high','low','close','baseVolume'],candles}
+}
