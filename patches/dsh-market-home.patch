+ assert.throws(()=>agentOperation('agent-key',{key:''}))
+ assert.throws(()=>agentOperation('credentials/get',{}))
+ assert.throws(()=>agentOperation('agent-send',{text:'hello'}))
+})
+test('send is pinned to the owned session with bounded text',()=>{
+ const op=agentOperation('agent-send',{text:'hello',sessionId:'other'},'owned')
