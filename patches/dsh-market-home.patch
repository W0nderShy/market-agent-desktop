+/** Narrow terminal operations over the existing dsh Host. */
+import { chartContext } from './chart-context.ts'
+import { randomUUID } from 'node:crypto'
+/** Terminal-specific editorial guidance, refreshed on every user turn. */
+const analystVoice = `[终端分析师表达要求]
+你是与用户共同研究市场的专业分析师。使用自然、准确、克制的中文，提供经过取舍的判断，不把工具日志或指标清单当成答案。遵循用户本轮对篇幅、格式和分析范围的明确要求。
+先直接回答用户的问题，给出当前判断和适用的标的、周期；随后用最相关的两三条证据解释判断，并在必要时说明反证或改变判断的条件。按问题组织连贯段落，不机械套用固定栏目；用户要求深入研究时可以充分展开。
+技术分析时按需读取并执行已安装的金融 Skill，用计算结果支撑论证。不要逐项复述五个 Skill，也不要默认展示原始字段、评分、完整指标表或执行命令。工具失败或数据缺失时直说，不冒充已完成计算。
+清楚区分已核实事实、外部来源转述与自己的推断。时间吻合不能直接证明因果；缩量不能单独证明无人承接；单次跌幅之比不能称为统计 beta。启发式评分不等于概率；没有可靠模型或统计依据，不编造情景概率或精确目标价。
+使用新闻前核对事件日期、时区和是否已经发生；历史快照不可冒充当前数据。未收盘 K 线的成交量不可直接与完整 K 线比较并据此宣称极度缩量。只有确实相关且核实的信息才进入正文，来源贴近对应论点。
+避免煽动性措辞（如市场已经否决、致命弱点、方向钥匙）和过度确定的断言。不要重复结论、堆免责声明、每次结尾主动推销下一份报告，或罗列未被询问的操作限制。仅在影响判断时简明说明数据局限。无需复述这些表达要求。
+`
+export function agentOperation(action: string, payload: unknown, sessionId?: string): {method:string;args:Record<string,unknown>} {
+ const data=(payload && typeof payload==='object'?payload:{}) as Record<string,unknown>
+ if(action==='agent-status')return {method:'credentials/describe',args:{refs:['DEEPSEEK_API_KEY']}}
+ if(action==='agent-models')return {method:'session/modelCatalog',args:{}}
+ if(action==='agent-key'){
+  if(typeof data.key!=='string'||!data.key.trim()||data.key.length>4096)throw new Error('请输入有效密钥')
+  return {method:'credentials/set',args:{ref:'DEEPSEEK_API_KEY',value:data.key.trim()}}
+ }
+ if(!sessionId)throw new Error('会话尚未创建')
+ if(action==='agent-skills')return {method:'skills/list',args:{request:{sessionId}}}
+ if(action==='agent-cancel')return {method:'session/cancel',args:{request:{sessionId}}}
+ if(action==='agent-send'){
+  if(typeof data.text!=='string'||!data.text.trim()||data.text.length>20000)throw new Error('消息长度需为 1–20000 字符')
+  return {method:'session/prompt',args:{request:{sessionId,requestId:randomUUID(),mode:'queue',content:[{type:'text',text:data.text},{type:'text',text:analystVoice + (data.chart ? '[当前图表上下文：以本次快照为准，历史对话中的标的可能不同。时间单位见 columns，最后一根未必收盘。]\n'+JSON.stringify(chartContext(data.chart))+'\n分析过程中可用 read 工具读取工作目录下 market-context.json 获取当前图表最新快照。可按需使用 web_search、web_fetch 搜集外部信息；引用时区分行情事实与推断。' : '[当前图表未就绪，不得假称看到了 K 线。]')}]}}}
+ }
+ throw new Error('不支持的 Agent 操作')
+}
diff --git a/apps/desktop/src/terminal-events.ts b/apps/desktop/src/terminal-events.ts
new file mode 100644
index 0000000000..dc1fb81c8d
--- /dev/null
+++ b/apps/desktop/src/terminal-events.ts
@@ -0,0 +1,44 @@
+/** Own dsh interaction events; approvals are answered only by an explicit UI action. */
+type Frame={type:string;clientId?:string;eventId?:string;event?:string;agentId?:string;request?:Record<string,unknown>}
+export class TerminalEvents {
+ private task: Promise<void>|undefined
+ private clientId: string|undefined
+ private pending=new Map<string,Frame>()
+ private ready: Promise<void>|undefined
+ constructor(private fetcher:(request:Request)=>Promise<Response>,private rpc:(method:string,args:Record<string,unknown>)=>Promise<unknown>){}
+ async start(){
+  if(!this.task){
+   let resolveReady!:()=>void
+   this.ready=new Promise<void>(resolve=>{resolveReady=resolve})
+   this.task=this.pump(resolveReady).catch(()=>undefined).finally(()=>{this.clientId=undefined;this.pending.clear();this.task=undefined;resolveReady()})
+  }
+  await this.ready
+  if(!this.clientId)throw new Error('dsh 交互连接不可用')
+ }
+ list(){return [...this.pending.values()]}
+ async answer(payload:unknown){
+  const data=payload as {eventId?:string;value?:unknown};const event=this.pending.get(data?.eventId??'')
+  if(!event||!this.clientId)throw new Error('请求已过期')
+  if(event.event==='approval/request'&&!['allowed-once','rejected'].includes(String(data.value)))throw new Error('无效审批结果')
+  if(event.event==='user-questions/request'&&(!data.value||typeof data.value!=='object'||!Array.isArray((data.value as {answers?:unknown}).answers)))throw new Error('无效回答')
+  await this.rpc('$events/result',{clientId:this.clientId,eventId:event.eventId,outcome:{kind:'result',value:data.value}})
+  this.pending.delete(event.eventId!)
+  return {answered:true}
+ }
+ private async pump(ready:()=>void){
+  const abort=new AbortController();const timer=setTimeout(()=>abort.abort(),15000)
+  const response=await this.fetcher(new Request('dsh-app://app/.dsh/remote-stream',{method:'POST',headers:{'content-type':'application/json'},signal:abort.signal,body:JSON.stringify({endpoint:'$events',payload:{args:{}}})}))
+  if(!response.ok||!response.body)throw new Error('事件连接失败')
+  const reader=response.body.getReader(),decoder=new TextDecoder();let pending=''
+  try{for(;;){const part=await reader.read();if(part.done)break;pending+=decoder.decode(part.value,{stream:true});let newline
+   while((newline=pending.indexOf('\n'))>=0){const line=pending.slice(0,newline);pending=pending.slice(newline+1);if(!line)continue;const frame=JSON.parse(line) as Frame
+    if(frame.type==='ready'){this.clientId=frame.clientId;clearTimeout(timer);ready()}
+    else if(frame.type==='cancel'&&frame.eventId)this.pending.delete(frame.eventId)
+    else if(frame.type==='waterfall'&&frame.eventId){
+     if(frame.event==='approval/request'||frame.event==='user-questions/request')this.pending.set(frame.eventId,frame)
+     else await this.rpc('$events/result',{clientId:this.clientId,eventId:frame.eventId,outcome:{kind:'next'}})
+    }
+   }
+  }}finally{clearTimeout(timer);await reader.cancel().catch(()=>undefined);abort.abort()}
+ }
+}
diff --git a/apps/desktop/src/tracking-worker.ts b/apps/desktop/src/tracking-worker.ts
new file mode 100644
index 0000000000..3ba0d75973
--- /dev/null
+++ b/apps/desktop/src/tracking-worker.ts
@@ -0,0 +1,88 @@
+/** Single leased research worker, isolated from the interactive terminal session. */
+import { readFile } from 'node:fs/promises'
+import { join } from 'node:path'
+
+type Rpc = (method:string,args:Record<string,unknown>)=>Promise<unknown>
+type Job = {id:string;lease:string;context:Record<string,unknown>}
+type Event = {type?:string;data?:{reason?:{kind?:string};message?:{content?:{type:string;text?:string}[]}}}
+export function finalResearch(snapshot:{records?:{event?:Event}[]}):string|undefined {
+ const events=(snapshot.records??[]).map(r=>r.event).filter((e):e is Event=>Boolean(e))
+ const end=[...events].reverse().find(e=>e.type==='turn/end')
+ if(!end)return undefined
+ if(end.data?.reason?.kind!=='completed')throw Error('research_failed')
+ const message=[...events].reverse().find(e=>e.type==='assistant/message')
+ const blocks=message?.data?.message?.content??[]
+ if(blocks.some(b=>b.type==='tool-call'))throw Error('unexpected_tool')
+ const text=blocks.filter(b=>b.type==='text').map(b=>b.text??'').join('\n')
+ if(!text)throw Error('missing_result')
+ return text
+}
+export function parseResearch(text:string):Record<string,unknown>{
+ const cleaned=text.trim().replace(/^```(?:json)?\s*/,'').replace(/\s*```$/,'')
+ if(cleaned.length>16000)throw Error('oversized_result')
+ const result:unknown=JSON.parse(cleaned)
+ if(!result||typeof result!=='object'||Array.isArray(result))throw Error('invalid_result')
+ return result as Record<string,unknown>
+}
+
+export function buildResearchPrompt(context:Record<string,unknown>):string {
+ return `你是长期资产追踪分析师，持续维护可修订的判断。本任务没有固定轮次或单日研究配额。按用户的长期追踪 role 依次审视：宏观金融环境、跨资产传导、资产基本面与客户资本开支、估值和叙事、反身性与泡沫、背离、量价结构、相对上次判断的边际变化。先识别证据来源和时间，再作判断；未知就是未知。
+输入中的 metrics.results 是已运行的五项量价 skill：market-trend、market-volume、market-s-r、market-breakout、market-exhaustion。逐项阅读其有效信号和局限，将它们交叉核验，不把分数当概率，也不能把任一技术标签直接映射为 BUY 或 SELL。比较 horizons 的 1H、4H、1D 与监测周期，短周期只用于候选变化。Bitget 公开 K 线只能验证价格与成交量；external_evidence 只代表列出的来源，不能推断未提供的新闻、财报、客户投资或估值。用户备注仅作待检验问题。
+输入中的 probabilities 由已收盘历史 K 线独立计算，BUY/SELL/HOLD 三项合计 100%，含义是未来指定窗口的涨/跌/震荡历史条件占比。它不是你的主观信心、已校准未来概率或交易盈亏胜率；不能据此伪称长期判断已确认，也不要在回答中自行改写百分比。
+对当前研究给出 action：buy、hold、sell、insufficient 四选一。区分两层判断：长期周期判断需要宏观、跨资产、基本面等证据；量价战术判断可以根据已收盘 K 线、五项技能和多周期结构给出 BUY/SELL，无需等待基本面全部接入。量价有明确方向和可验证失效条件时直接判断，不因外部维度缺失自动 HOLD；五项技能不必全都同向，但要权衡主要反证。如果仅有量价依据，结论明确限定为战术层面，不能声称已确认长期正反馈。HOLD 也须有具体理由；只有量价互相矛盾或输入不足以建立方向时才用 insufficient。此为研究判断，不下单，不假定用户仓位、成本或风险偏好。若长期阶段的关键证据缺失，cycle_state 为 undetermined。
+恢复时先复盘 coverage 中断区间及 previous，指出判断维持、加强、削弱或推翻。先给一句结论和下一步核验建议，summary 只解释两三条决定性证据、主要反证与缺口，不罗列全部指标；日期用北京时间，不输出输入字段名、Unix 时间戳或补充指令。
+仅输出 JSON，字段：action（buy/hold/sell/insufficient）, action_reason（一句话说明判断依据或缺失证据）, conclusion（一句话结论，最多 80 个汉字）, recommendation（一句话下一步核验建议，最多 100 个汉字）, summary（中文分析，100–250 字）, evidence（最多 3 条关键事实）, bias（bullish/bearish/neutral）, invalidation（判断失效条件）, cycle_state（early_recovery/fundamental_confirmation/full_flywheel/narrative_expansion/bubble_formation/narrative_divergence/fundamental_divergence/cycle_deterioration/undetermined）, thesis（持续追踪的核心判断）, change_vs_previous（与上次相比的边际变化）, confirmations（支持事实）, contradictions（反证）, unknowns（缺失证据）, upper/lower（可选观察位，不是目标价）。
+`+JSON.stringify(context)
+}
+
+export class TrackingWorker {
+ private busy=false
+ private stopped=false
+ private session:string|undefined
+ private timer:ReturnType<typeof setInterval>|undefined
+ constructor(private root:string,private rpc:Rpc,private follow:(id:string)=>Promise<unknown>){}
+ start():void {this.timer=setInterval(()=>{void this.pump()},5000);this.timer.unref()}
+ stop():void {this.stopped=true;if(this.timer)clearInterval(this.timer);if(this.session)void this.rpc('session/cancel',{request:{sessionId:this.session}}).catch(()=>undefined)}
+ private async api(path:string,body:Record<string,unknown>):Promise<Record<string,unknown>>{
+  const token=(await readFile(join(this.root,'runtime','api-token'),'utf8')).trim()
+  const response=await fetch('http://127.0.0.1:8765/api/tracking/'+path,{method:'POST',headers:{'Content-Type':'application/json','X-Monitor-Token':token},body:JSON.stringify(body),signal:AbortSignal.timeout(15000),redirect:'error'})
+  if(!response.ok)throw Error('tracking_unavailable')
+  return await response.json() as Record<string,unknown>
+ }
+ private async pump():Promise<void>{
+  if(this.busy||this.stopped)return
+  this.busy=true;let job:Job|undefined
+  try {
+   // Claim also advertises worker liveness, without accessing the credential value.
+   const claimed=await this.api('claim',{})
+   job=claimed.job as Job|undefined
+   if(!job)return
+   const credentials=await this.rpc('credentials/describe',{refs:['DEEPSEEK_API_KEY']}) as {DEEPSEEK_API_KEY?:{configured:boolean}}
+   if(!credentials.DEEPSEEK_API_KEY?.configured)throw Error('model_unconfigured')
+   const catalog=await this.rpc('session/modelCatalog',{}) as {groups:{id:string;name:string;models:{id:string}[]}[]}
+   const group=catalog.groups.find(g=>g.id==='deepseek-official')
+   const model=group?.models.find(m=>/flash|chat/.test(m.id))??group?.models[0]
+   if(!group||!model)throw Error('model_unavailable')
+   const created=await this.rpc('session/create',{request:{cwd:join(this.root,'runtime'),agentPreset:'market-research'}}) as {sessionId:string}
+   this.session=created.sessionId
+   await this.rpc('session/selectModel',{request:{sessionId:this.session,provider:group.id,model:model.id}})
+   const prompt=buildResearchPrompt(job.context)
+   await this.rpc('session/prompt',{request:{sessionId:this.session,requestId:crypto.randomUUID(),mode:'queue',content:[{type:'text',text:prompt}]}})
+   const deadline=Date.now()+480000
+   while(!this.stopped&&Date.now()<deadline){
+    const health=await this.api('heartbeat',{id:job.id,lease:job.lease})
+    if(!health.active)throw Error('task_paused')
+    const snapshot=await this.follow(this.session) as Parameters<typeof finalResearch>[0]
+    const text=finalResearch(snapshot)
+    if(text!==undefined){await this.api('complete',{id:job.id,lease:job.lease,result:parseResearch(text)});return}
+    await new Promise(resolve=>setTimeout(resolve,3000))
+   }
+   throw Error('research_timeout')
+  }catch{
+   if(job)await this.api('complete',{id:job.id,lease:job.lease,error:'research_failed'}).catch(()=>undefined)
+  }finally{
+   if(this.session)await this.rpc('session/cancel',{request:{sessionId:this.session}}).catch(()=>undefined)
+   this.session=undefined;this.busy=false
+  }
+ }
+}
