+import { describe, expect, it } from 'vitest'
+import { assertMarketSender, marketAsset, marketRequest } from '../src/market-home.ts'
+
+describe('market home restrictions', () => {
+  it('serves only the owned assets', () => {
+    expect(marketAsset('dsh-app://market/index.html')).toBe('index.html')
+    expect(marketAsset('dsh-app://market/market-tracking-view.js')).toBe('market-tracking-view.js')
+    for (const url of ['dsh-app://market/api-token', 'dsh-app://app/index.html', 'dsh-app://market/%2e%2e%2fapi-token', 'https://market/index.html']) {
+      expect(marketAsset(url)).toBeUndefined()
+    }
+  })
+  it('requires the owned main webContents and its top-level exact page', () => {
+    const frame = { url: 'dsh-app://market/index.html' }
+    const owner = { mainFrame: frame }
+    expect(() => assertMarketSender({ sender: owner, senderFrame: frame }, owner)).not.toThrow()
+    expect(() => assertMarketSender({ sender: {}, senderFrame: frame }, owner)).toThrow()
+    expect(() => assertMarketSender({ sender: owner, senderFrame: { ...frame } }, owner)).toThrow()
+    frame.url = 'dsh-app://app/index.html'
+    expect(() => assertMarketSender({ sender: owner, senderFrame: frame }, owner)).toThrow()
+  })
+  it('limits API requests to supported actions and validates inputs', () => {
+    expect(marketRequest('status')).toEqual({ method: 'GET', path: '/api/status' })
+    expect(marketRequest('poll')).toEqual({ method: 'POST', path: '/api/poll' })
+    expect(marketRequest('candles', { category: 'SPOT', symbol: 'BTCUSDT', interval: '1H' }).path).toContain('/api/candles?category=SPOT&symbol=BTCUSDT&interval=1H')
+    expect(marketRequest('watchlist', { items: [{ symbol: 'BTCUSDT', category: 'SPOT', token: 'ignored' }] }).body).toEqual({ items: [{ symbol: 'BTCUSDT', category: 'SPOT' }] })
+    expect(marketRequest('tracking-history', {category:'USDT-FUTURES',symbol:'ZECUSDT',before:'1000|event-01'}).path).toContain('task=USDT-FUTURES%3AZECUSDT')
+    expect(marketRequest('wechat-login')).toEqual({method:'POST',path:'/api/wechat/login'})
+    expect(marketRequest('wechat-configure',{enabled:true,cadence_hours:6}).body).toEqual({enabled:true,cadence_hours:6})
+    expect(() => marketRequest('wechat-configure',{sendkey:'secret'})).toThrow()
+    expect(() => marketRequest('wechat-login-status',{verify_code:'../../secret'})).toThrow()
+    expect(() => marketRequest('tracking-history', {category:'USDT-FUTURES',symbol:'../private'})).toThrow()
+    expect(() => marketRequest('tracking-history', {category:'USDT-FUTURES',symbol:'ZECUSDT',before:'../../secret'})).toThrow()
+    for (const action of ['http://evil.test', '/api/secrets', 'delete', '__proto__']) expect(() => marketRequest(action)).toThrow()
+    expect(() => marketRequest('watchlist', { items: Array(51).fill({}) })).toThrow()
+    expect(() => marketRequest('instruments', { symbol: '../private' })).toThrow()
+    expect(() => marketRequest('candles', { symbol: 'BTCUSDT', interval: '../secret' })).toThrow()
+  })
+})
