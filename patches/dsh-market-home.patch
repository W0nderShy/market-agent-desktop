+import {test} from 'node:test'
+import assert from 'node:assert/strict'
+import {TerminalEvents} from '../src/terminal-events.ts'
+test('approval remains pending until explicit answer; stale and invalid decisions fail',async()=>{
+ let controller!:ReadableStreamDefaultController<Uint8Array>;const calls:unknown[]=[]
+ const stream=new ReadableStream<Uint8Array>({start(c){controller=c;c.enqueue(new TextEncoder().encode(JSON.stringify({type:'ready',clientId:'client'})+'\n'+JSON.stringify({type:'waterfall',eventId:'e',event:'approval/request',request:{toolName:'shell',reason:'test'}})+'\n'))}})
+ const events=new TerminalEvents(async()=>new Response(stream),async(m,a)=>{calls.push({m,a})})
+ await events.start();assert.equal(events.list().length,1);assert.equal(calls.length,0)
+ await assert.rejects(events.answer({eventId:'e',value:'always'}));assert.equal(calls.length,0)
+ await events.answer({eventId:'e',value:'rejected'});assert.equal(calls.length,1);assert.equal(events.list().length,0)
+ await assert.rejects(events.answer({eventId:'e',value:'allowed-once'}));controller.close()
+})
